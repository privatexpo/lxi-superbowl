# ── Back-office /admin ──────────────────────────────────────
ADMIN_PASSWORD=changez-moi-mot-de-passe-long

# ── WooCommerce + Pay50 (comme FFF / RFEF / FFR) ────────────
# Boutique WordPress LXI. Paiement = plugin PAY50 (id pay50).
# Le checkout client passe par le front paiement séparé (pas Portinax).
WC_URL=https://ton-wordpress-lxi.wpcomstaging.com
WC_CONSUMER_KEY=ck_xxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxx
WC_MATCH_IDS=
WC_PAYMENT_METHOD=pay50
WC_CHECKOUT_PATH=commander
WC_WEBHOOK_SECRET=

# Domaine de checkout (front-paiement) — pas le site billetterie.
# URL publique Pay50 / Storefront côté Woo :
#   https://www.payhubticket.com/lxi
PAYMENT_FRONT_URL=https://www.payhubticket.com
PAYMENT_FRONT_PATH=lxi
# Retour  https://www.payhubticket.com/lxi/?wc-api=pay50_return
# Webhook https://www.payhubticket.com/lxi/?wc-api=pay50_webhook

# ── Import matchs (scripts/) ────────────────────────────────
WOO_STOCK_UPPER=120
WOO_STOCK_LOWER=80
WOO_STOCK_CLUB=40

# ── Site billetterie ────────────────────────────────────────
SITE_URL=https://www.lxisuperticket.com
NEXT_PUBLIC_SITE_URL=https://www.lxisuperticket.com
SITE_NAME=LXI Super Ticket
SITE_LABEL=🏈 LXI

# ── E-mails (Brevo) ─────────────────────────────────────────
BREVO_API_KEY=
MAIL_FROM=LXI Super Ticket <billets@lxisuperticket.com>
MAIL_LOGO=
MAIL_QR=
CONTACT_EMAIL=support@lxisuperticket.com

# ── Notifications Telegram ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Meta Conversions API (optionnel) ────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=

# ── Apple Pay (domaine = front paiement /lxi) ───────────────
# Fichier de vérif Apple servi sur le domaine PAYMENT_FRONT_URL
# (ex. www.payhubticket.com), pas sur lxisuperticket.com.
# Dans Woo → Pay50 : Storefront URL = https://www.payhubticket.com/lxi
APPLE_PAY_DOMAIN_ASSOCIATION=

# ── Billetterie ─────────────────────────────────────────────
NEXT_PUBLIC_CART_RESERVATION_SECONDS=600
NEXT_PUBLIC_MAX_TICKETS_PER_ORDER=6
QUEUE_MIN_MS=2000
QUEUE_MAX_MS=2000

# ── Cron ────────────────────────────────────────────────────
CRON_SECRET=
